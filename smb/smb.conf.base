[global]
   workgroup = WORKGROUP
   server string = OmniCloud
   security = user
   map to guest = never
   server min protocol = SMB2_10
   server signing = auto
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log level = 1
   log file = /var/log/samba/log.%m
   max log size = 1000

   # Os shares por usuário são acrescentados abaixo pelo provisionador.

PORT=8787

# Application mode:
#   local  -> single-user, no login screen (default; for personal/self-hosted use)
#   hosted -> multi-user, requires register/login; all data scoped per user
APP_MODE=local

# Frontend origin allowed by CORS. In hosted mode cookies are shared with this origin.
CORS_ORIGIN=http://localhost:5173
# Optional: explicit frontend URL used for OAuth redirects (defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

SYNC_INTERVAL_MINUTES=5
OMNICLOUD_SECRET_HALF=replace-this-with-random-half-key

# Auth/session settings (used in hosted mode)
AUTH_COOKIE_NAME=omnicloud_session
AUTH_SESSION_TTL_HOURS=336
# Secret used to derive session token hashes. Set a strong random value in hosted mode.
AUTH_SECRET=replace-this-with-a-strong-random-secret

# Durable local file cache
FILE_CACHE_PATH=.cache/files
FILE_CACHE_WARM_TTL_MS=3600000
FILE_CACHE_CONCURRENCY=3

# Internal MegaBasterd sidecar. Set the same strong secret on both services.
MEGABASTERD_URL=http://megabasterd:8788
MEGABASTERD_INTERNAL_SECRET=
MEGABASTERD_TIMEOUT_MS=15000
MEGABASTERD_FALLBACK_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/accounts/google/callback
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:8787/api/accounts/onedrive/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8787/api/accounts/dropbox/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8787/api/accounts/yandex/callback

# Inbound S3 gateway; independent of outbound S3 provider credentials.
S3_GATEWAY_ENABLED=false
S3_GATEWAY_BUCKET=omnicloud
S3_GATEWAY_REGION=auto
S3_GATEWAY_ENDPOINT=https://s3.example.com
# Compose overrides this to /app/data/s3-multipart (existing persistent data volume).
S3_MULTIPART_PATH=data/s3-multipart
S3_MULTIPART_TTL_HOURS=24
# Aggregate staging quota, not a per-object size limit. Default 1 TiB.
S3_STAGING_MAX_BYTES=1099511627776
S3_MAX_UPLOADS_PER_USER=100
S3_MAX_CONCURRENT_REQUESTS=32
S3_REQUEST_TIMEOUT_MS=3600000
